FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt

# These are the exact artifact and evaluation metadata generated by the
# reproducible training command. The API checks their hash and schema at startup.
COPY models/fraud_model.joblib /app/models/fraud_model.joblib
COPY reports/evaluation_metrics.json /app/reports/evaluation_metrics.json
COPY src /app/src

EXPOSE 8080
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
